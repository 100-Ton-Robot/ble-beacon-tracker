/*
 * Gateway UART (uart21) TX moved from D6 (P2.08) to D8 (P2.01), 2026-11-19, so all four
 * harness wires (5V, GND, D7 RX, D8 TX) leave the XIAO from the same pin row.
 * RX stays on D7 (P2.07, pull-up from the board file). D6 is no longer used.
 *
 * D8 is the board's default SPI SCK (spi00). SPI isn't built (CONFIG_SPI is off), but the
 * node is disabled too so nothing else can claim P2.01.
 */

&pinctrl {
	uart21_default: uart21_default {
		group1 {
			psels = <NRF_PSEL(UART_TX, 2, 1)>;
		};
	};

	uart21_sleep: uart21_sleep {
		group1 {
			psels = <NRF_PSEL(UART_TX, 2, 1)>,
				<NRF_PSEL(UART_RX, 2, 7)>;
		};
	};
};

&spi00 {
	status = "disabled";
};
