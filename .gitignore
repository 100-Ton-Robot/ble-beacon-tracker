# Build output (regenerate with west build, see scanner_fw/README.md)
scanner_fw/build/
scanner_fw/build.log
__pycache__/
*.pyc

# ESPHome local build state and real secrets (secrets.example.yaml is tracked)
.esphome/
secrets.yaml

# Signing keys never go in the repo (MCUboot key path is set in scanner_fw/sysbuild.conf)
*.pem

# KiCad per-user state and experiment renders
*.kicad_prl
experiments/*/out/

# Personal working notes (Claude Code loads CLAUDE.local.md automatically)
*.local.md
